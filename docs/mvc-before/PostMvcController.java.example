// 비교용 MVC 예제. 제공된 이전 프로젝트의 실제 소스나 실행 대상이 아닙니다.
// 같은 서비스 계층을 쓰되 서버가 HTML 뷰 이름을 반환하는 방식입니다.
@Controller
@RequestMapping("/posts")
public class PostMvcController {
    private final PostService posts;

    public PostMvcController(PostService posts) {
        this.posts = posts;
    }

    @GetMapping
    public String list(Model model) {
        model.addAttribute("feed", posts.feed(null, "all", "", null, null));
        return "posts/list"; // 서버 템플릿에서 HTML 생성
    }

    @PostMapping
    public String create(@ModelAttribute PostForm form, Authentication auth) {
        posts.create(Long.parseLong(auth.getName()), form.content(),
            form.postType(), form.externalUrl(), form.tags());
        return "redirect:/posts"; // 화면 이동으로 결과 전달
    }
}
